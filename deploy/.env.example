# Copier en `deploy/.env` (jamais committé — voir .gitignore). Toutes les valeurs marquées <...>
# sont à générer, jamais à recopier d'un exemple, jamais journalisées une fois posées.

# --- Keycloak (production, Postgres-backed) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
# openssl rand -base64 24
KC_BOOTSTRAP_ADMIN_PASSWORD=<à générer>
# openssl rand -base64 24 — sert à la fois à Postgres (POSTGRES_PASSWORD) et à Keycloak (KC_DB_PASSWORD)
# dans docker-compose.yml, une seule variable pour ne jamais les faire diverger.
KC_DB_PASSWORD=<à générer>

# --- Coffre applicatif (Q3, LOT0-04, D3) ---
# openssl rand -base64 32 (256 bits AES, encodés en base64). Le service refuse de démarrer sans —
# voir vault/spi/env/EnvMasterKeyProvider.kt. Val l'opère lui-même, jamais une valeur de complaisance,
# jamais un agent qui la génère à sa place (RUNBOOK.md, section « Ce qui reste bloqué sur Val »).
CATALOG_MASTER_KEY=

# --- Version déployée — posée par scripts/deploy.sh, ne JAMAIS éditer cette ligne à la main ---
RELEASE_TAG=

# --- Emplacement du dépôt TypeScript (dépôt B) sur cette machine ---
MCP_SHOPIFY_CATALOG_PATH=/home/val/IA_sandbox/mcp-shopify-catalog

# --- Fichier de config multi-site du poste qui fait tourner le process TS relayé (LOT2-10) ---
# Monté en lecture seule dans le conteneur `shopify-mcp-server-ts` (il tourne en `root`, donc
# `os.homedir()` y vaut `/root`, jamais `/home/val` — sans ce montage explicite le fichier de l'hôte
# est invisible du conteneur, quel que soit son contenu). Non secret en soi (déjà pas un secret côté
# hôte — voir ACCESS-RUNBOOK.md), mais le chemin par défaut suffit tant qu'une seule machine sert.
SHOPIFY_CATALOG_CREDENTIALS_PATH=/home/val/.config/shopify-catalog/credentials.json
