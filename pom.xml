<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Triplet D14, actée le 2026-08-07 et vérifiée deux fois au runtime (LOT0-01, puis rejeu
         complet sous D14 — voir progress.md des deux mêmes dates). Ne PAS déclarer de propriété
         kotlin.version ici : elle doit venir par héritage de spring-boot-dependencies:4.1.0
         (résout à 2.3.21). Forcer une version hors BOM est précisément ce qui avait fait dériver
         le triplet précédent de deux lignes Kotlin (2.2.21 au lieu de ce que Boot gérait lui-même). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.zickat</groupId>
    <artifactId>shopify-mcp-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>shopify-mcp-server</name>
    <description>Serveur MCP distant du catalogue Shopify — credentials, OAuth, droits par boutique, audit</description>

    <properties>
        <java.version>21</java.version>
        <!-- kotlin.version : volontairement absent, héritée du BOM spring-boot-dependencies:4.1.0
             (D14). Vérifier avec `mvn help:evaluate -Dexpression=kotlin.version -q -DforceStdout`. -->
        <spring-ai.version>2.0.0</spring-ai.version>
        <spring-modulith.version>2.1.0</spring-modulith.version>
        <arrow.version>2.2.3</arrow.version>
        <shedlock.version>7.7.0</shedlock.version>
        <springdoc.version>3.1.0</springdoc.version>
        <!-- Non gérées par le BOM Boot (libs hors périmètre Spring) : version épinglée à la main,
             vérifiée disponible sur Maven Central au 2026-08-07. -->
        <logstash-logback-encoder.version>9.0</logstash-logback-encoder.version>
        <kotlinx-datetime.version>0.8.0</kotlinx-datetime.version>
        <kotest.version>6.2.3</kotest.version>
        <!-- LOT0-05 : candidate D14 pour le resource server OAuth 2.1. Ligne pré-1.0 (14
             publications en 7 mois) — épinglée en version exacte, jamais en plage ouverte
             (mise en garde de la tâche, valable quel que soit le choix final documenté dans
             progress.md). -->
        <mcp-server-security.version>0.1.14</mcp-server-security.version>
        <mockwebserver.version>5.4.0</mockwebserver.version>
        <!-- BE-2 (catalog-server-hexagonal-realignment, D48) : absente de tout BOM du projet —
             vérifié. Dernière version stable de la famille 1.x sur Maven Central au 2026-08-14
             (1.4.1, la 1.x la plus récente ; pas de 1.5.x publiée à ce jour). -->
        <archunit.version>1.4.1</archunit.version>
    </properties>

    <dependencies>
        <!-- Kotlin -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-serialization-json</artifactId>
        </dependency>
        <!-- LOT5-02 : parsing de brand.yaml (com.fasterxml.jackson.* — pas tools.jackson.*, la
             famille 3.x apportée transitivement par spring-ai). Pas de <version> : déjà résolue
             transitivement à 2.21.4 par spring-boot-dependencies (même famille que
             jackson-module-kotlin ci-dessus) — la déclarer explicitement la rend directe au lieu
             de transitive, sans changer la version qui tourne. -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-datetime-jvm</artifactId>
            <version>${kotlinx-datetime.version}</version>
        </dependency>

        <!-- Transport MCP — D14 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <!-- Resource server OAuth 2.1 — LOT0-05 (D2 : on valide des jetons, on n'en émet pas).
             spring-boot-starter-oauth2-resource-server amène spring-boot-starter-security +
             spring-security-oauth2-resource-server + spring-security-oauth2-jose, toutes
             gouvernées par notre BOM Boot 4.1 / Spring Security 7.1.0. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- mcp-server-security (PAS -spring-boot) : on utilise la plomberie DSL
             (McpServerOAuth2Configurer — PRM/RFC 9728, entry point WWW-Authenticate) mais pas son
             auto-configuration ni sa validation d'audience native (qui dérive l'audience attendue
             du Host de la requête entrante, pas d'une constante — voir
             identity/AudienceValidator.kt). Toutes ses dépendances Spring Security sensibles sont
             en scope provided dans SON pom : c'est notre BOM D14 qui décide de la version qui
             tourne réellement, jamais la lib — vérifié en inspectant
             mcp-server-security-0.1.14.pom avant de l'ajouter ici. -->
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>mcp-server-security</artifactId>
            <version>${mcp-server-security.version}</version>
        </dependency>

        <!-- Persistance — D9 (MongoDB, pas Mongock) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-kotlin-sync</artifactId>
        </dependency>

        <!-- Verrou distribué -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>${shedlock.version}</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-mongo</artifactId>
            <version>${shedlock.version}</version>
        </dependency>

        <!-- Fonctionnel -->
        <dependency>
            <groupId>io.arrow-kt</groupId>
            <artifactId>arrow-core</artifactId>
            <version>${arrow.version}</version>
        </dependency>

        <!-- Client HTTP sortant — LOT2-01 (module shopify, seul point de couture vers l'API Admin
             Shopify). Boot 4.1 a extrait RestClient.Builder et RestTemplateBuilder de
             spring-boot-autoconfigure vers ce module dédié ; jusqu'ici déclaré en scope test
             uniquement (pour spring-boot-resttestclient, LOT0-05). Repassé en scope par défaut :
             c'est ce module qui fournit le bean RestClient.Builder auto-configuré, injecté dans
             ShopifyRestClientHttpClient — sans lui, aucun RestClient.Builder au démarrage réel de
             l'application, seulement dans les tests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
        </dependency>

        <!-- Modulith -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
            <version>${spring-modulith.version}</version>
        </dependency>

        <!-- Observabilité / doc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-logback-encoder.version}</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4.1 a extrait TestRestTemplate de spring-boot-test vers ce module dédié
             (org.springframework.boot.resttestclient.TestRestTemplate) — plus transitif via
             spring-boot-starter-test, constaté à la compilation. Nécessaire pour
             ResourceServerSecurityTest (LOT0-05), le seul test qui a besoin d'un vrai contexte
             Spring + une vraie requête HTTP (filtre de sécurité, pas un controller applicatif). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <version>${spring-modulith.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.kotest</groupId>
            <artifactId>kotest-assertions-core-jvm</artifactId>
            <version>${kotest.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.kotest</groupId>
            <artifactId>kotest-assertions-arrow-jvm</artifactId>
            <version>${kotest.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- testing.md : "HTTP mocks : OkHttp MockWebServer pour les appels externes". LOT0-05 :
             sert un JWKS de test en HTTP réel sur localhost (aucun IdP réel, aucun appel réseau
             externe) pour exercer le vrai chemin NimbusJwtDecoder.withJwkSetUri(...). -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>${mockwebserver.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers — LOT0-03. Versions gérées par le BOM Boot 4.1 (testcontainers-bom
             2.0.5, importé par spring-boot-dependencies). Testcontainers 2.x a renommé ses
             artefacts (préfixe testcontainers- : testcontainers-mongodb, pas mongodb — constaté
             en cherchant l'ancien nom, absent de Maven Central sous cette ligne). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mongodb</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- BE-2 : HexagonalArchitectureTest — les 12 règles de architecture.md §4. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                        <arg>-Xannotation-default-target=param-property</arg>
                    </args>
                    <compilerPlugins>
                        <plugin>spring</plugin>
                        <plugin>kotlinx-serialization</plugin>
                    </compilerPlugins>
                </configuration>
                <dependencies>
                    <!-- ${kotlin.version} n'est pas déclarée dans ce pom : elle est résolue par
                         héritage depuis spring-boot-dependencies:4.1.0. Référencée ici pour que ces
                         plugins-dépendances utilisent la même version que le compilateur Kotlin,
                         sans jamais la fixer nous-mêmes. -->
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-serialization</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
