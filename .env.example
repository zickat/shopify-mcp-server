# Connexion MongoDB (backend.md — mongodb-driver-kotlin-sync + Spring Data MongoDB).
MONGODB_URI=mongodb://localhost:27017/shopify_mcp_server

# Resource server OAuth 2.1 (LOT0-05). Q1 (choix de l'IdP) n'est pas tranchée : ces trois valeurs
# sont les SEULES à changer pour brancher un vrai IdP au lot 2, aucun code à toucher.
# OAUTH_ISSUER_URI : issuer de l'autorisation server tiers (Q1), publié dans le document PRM.
# OAUTH_JWK_SET_URI : JWKS servi par cet IdP, utilisé pour vérifier la signature des jetons reçus.
# MCP_EXPECTED_AUDIENCE : URL publique de CE serveur (le "resource" RFC 8707) — la valeur que doit
# porter le claim "aud" d'un jeton pour être accepté ici. Ce n'est jamais deviné depuis la requête.
OAUTH_ISSUER_URI=https://idp.example.com/
OAUTH_JWK_SET_URI=https://idp.example.com/.well-known/jwks.json
MCP_EXPECTED_AUDIENCE=https://shopify-mcp-server.example.com/mcp

# La clé maîtresse du coffre (LOT0-04) sera ajoutée par la tâche qui l'introduit — pas
# retro-ajoutée en bloc ici.
